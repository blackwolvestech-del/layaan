# -----------------------------------------------------------------------------
# LAYAAN storefront — environment variables. Copy to .env.local for local work;
# set the same names in Vercel → Project → Settings → Environment Variables.
# -----------------------------------------------------------------------------

# Shared Supabase project (the same one the LAYAAN CRM uses). Public by design.
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
# Publishable key (sb_publishable_…) or the legacy anon key. Safe in the browser:
# the database only exposes the read-only storefront_* RPCs and customers' own data.
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx

# SERVER ONLY — used by the Vercel Functions in /api (checkout, order lookup,
# returns). Never prefix with VITE_, never expose to the browser, never commit.
SUPABASE_SERVICE_ROLE_KEY=sb_secret_xxxxxxxxxxxxxxxxxxxxxxxx

# Optional: CRM origin, linked from the storefront's /admin page.
VITE_CRM_URL=https://your-crm.example.com
